{%- liquid
  assign product = section.settings.product | default: product
  assign variant = product.selected_or_first_available_variant
-%}

<p class="product-info__sku" {{ block.shopify_attributes }}>
  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
  <span class="caption text-s secondary" data-sku>{{- variant.sku -}}</span>
</p>

{% style %}
.product-info__sku .caption {
  font-family: var(--font-body-family);
  font-style: var(--font-body-style);
  font-weight: var(--font-body-weight);
  font-size: var(--font-s-size);
  text-transform: none;
  letter-spacing: var(--font-body-letter-spacing);
}
{% endstyle %}

{% schema %}
{
  "name": "t:sku",
  "tag": null,
  "presets": [
    {
      "name": "t:sku"
    }
  ]
}
{% endschema %}