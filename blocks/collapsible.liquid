      "default": "heading h6",
      "label": "t:heading-font"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:open-by-default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:collapsible",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}