{%- comment -%}
  AEO: on the FAQ page, mark each question and answer up as schema.org FAQPage microdata so search and AI
  can read them. The answer text comes from this block's own content, so it always matches what is shown.
  Answers known to be out of date are left out until they are corrected (list their exact question text in faq_skip below).
{%- endcomment -%}
{%- assign faq_markup = false -%}

{%- if request.page_type == 'page' and template.suffix == 'faq' -%}
  {%- assign faq_skip = 'Where do you ship to?' | split: '|' -%}
  {%- assign faq_question = block.settings.heading | strip_html | strip -%}
  {%- unless faq_skip contains faq_question -%}
    {%- assign faq_markup = true -%}
  {%- endunless -%}
{%- endif -%}
{% capture text %}<div class="rte"{% if faq_markup %} itemprop="text"{% endif %}>{% content_for 'blocks' %}</div>{% endcapture %}
<div class="rich-text__collapsible collapsible-items justify-left left" {{ block.shopify_attributes }}{% if faq_markup %} itemprop="mainEntity" itemscope itemtype="https://schema.org/Question"{% endif %}>
  {%- render 'collapsible-content', heading: block.settings.heading, text: text, heading_size: block.settings.font_style, open: block.settings.open_by_default, faq_markup: faq_markup -%}
</div>

{% schema %}
{
  "name": "t:collapsible",
  "tag": null,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    },
    {
      "type": "_video"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:heading",
      "default": "t:collapsible"
    },
    {
      "type": "select",
      "id": "font_style",
      "options": [
        {
          "value": "heading h1",
          "label": "t:heading-1",
          "group": "Heading"
        },
        {
          "value": "heading h2",
          "label": "t:heading-2",
          "group": "Heading"
        },
        {
          "value": "heading h3",
          "label": "t:heading-3",
          "group": "Heading"
        },
        {
          "value": "heading h4",
          "label": "t:heading-4",
          "group": "Heading"
        },
        {
          "value": "heading h5",
          "label": "t:heading-5",
          "group": "Heading"
        },
        {
          "value": "heading h6",
          "label": "t:heading-6",
          "group": "Heading"
        },
        {
          "value": "subheading",
          "label": "t:subheading",
          "group": "Heading"
        },
        {
          "value": "caption",
          "label": "t:caption",
          "group": "Caption"
        },
        {
          "value": "caption-xs",
          "label": "t:xsmall-caption",
          "group": "Caption"
