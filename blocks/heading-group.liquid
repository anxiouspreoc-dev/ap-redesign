{% liquid
assign heading_level = 'h2'
if block.settings.page_title == true
  assign heading_level = 'h1'
endif
# Collection pages display their title through this block, so render it as the page H1.
# (Done in code because the editor-stored collection template can override the page_title setting.)
if request.page_type == 'collection'
  assign heading_level = 'h1'
endif
-%}

<{{ heading_level }} {{ block.shopify_attributes }} {% if block.settings.anchor_id != blank %}id="{{ block.settings.anchor_id | handleize }}"{% endif %} class="rich-text__heading-group heading-group media-banner__pointer">
  {% content_for 'blocks' %}
</{{  heading_level }}>

{% schema %}
{
  "name": "t:heading",
  "tag": null,
  "blocks": [
    {
      "type": "_heading"
    },
    {
      "type": "_subheading"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional. Add an id so this heading can be linked to with a URL hash (e.g. 'preorders' → link to '#preorders')."
    },
    {
      "type": "checkbox",
      "id": "page_title",
      "label": "t:set-as-page-title",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:heading",
      "blocks": [
        {
          "type": "_subheading"
        },
        {
          "type": "_heading"
        }
      ]
    }
  ]
}
{% endschema %}