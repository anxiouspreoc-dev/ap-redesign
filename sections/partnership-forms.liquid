{%- comment -%}
  Wholesale + Creator/Influencer enquiry buttons for the Contact page.
  Each button reveals a Hulk Form Builder form (paste the form's embed code / shortcode in the settings).
  Everything is hidden from visitors unless the URL contains ?dev=1 (content is held in <template>
  tags, so the Hulk scripts do not even load for normal visitors).
{%- endcomment -%}

<div {% render 'color-scheme-attributes', scoped_settings: section.settings, borders: true %}>
  <div class="padding--section" style="{% render 'padding-override', settings: section.settings %}">
    <partnership-forms class="partnership-forms" data-gate="{{ section.settings.gate_dev }}" hidden>
      <div class="partnership-forms__inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="partnership-forms__heading h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="partnership-forms__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <div class="partnership-forms__buttons" role="tablist">
          <button type="button" class="button button--secondary" role="tab" aria-selected="false" aria-controls="pf-wholesale-{{ section.id }}" data-target="wholesale">
            {{ section.settings.wholesale_button }}
          </button>
          <button type="button" class="button button--secondary" role="tab" aria-selected="false" aria-controls="pf-creator-{{ section.id }}" data-target="creator">
            {{ section.settings.creator_button }}
          </button>
        </div>

        <div class="partnership-forms__panel" id="pf-wholesale-{{ section.id }}" data-panel="wholesale" role="tabpanel" hidden>
          {%- if section.settings.wholesale_intro != blank -%}
            <p class="partnership-forms__intro">{{ section.settings.wholesale_intro }}</p>
          {%- endif -%}
          <template data-form="wholesale">{{ section.settings.wholesale_embed }}</template>
        </div>

        <div class="partnership-forms__panel" id="pf-creator-{{ section.id }}" data-panel="creator" role="tabpanel" hidden>
          {%- if section.settings.creator_intro != blank -%}
            <p class="partnership-forms__intro">{{ section.settings.creator_intro }}</p>
          {%- endif -%}
          <template data-form="creator">{{ section.settings.creator_embed }}</template>
        </div>
      </div>
    </partnership-forms>
  </div>
</div>

<style>
  .partnership-forms__inner { max-inline-size: 40rem; margin-inline: auto; text-align: center; }
  .partnership-forms__heading { margin-block-end: 0.75rem; }
  .partnership-forms__text { margin-block-end: 1.5rem; }
  .partnership-forms__buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  .partnership-forms__buttons .button[aria-selected="true"] { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }
  .partnership-forms__panel { margin-block-start: 2rem; text-align: start; }
  .partnership-forms__intro { margin-block-end: 1.25rem; text-align: center; }
</style>

<script>
  (() => {
    if (customElements.get('partnership-forms')) return;
    customElements.define('partnership-forms', class extends HTMLElement {
      connectedCallback() {
        // Gate: only reveal with ?dev=1 (or in the theme editor) while gating is on.
        const gated = this.dataset.gate === 'true';
        const allowed = !gated
          || new URLSearchParams(window.location.search).get('dev') === '1'
          || Boolean(window.Shopify && window.Shopify.designMode);
        if (!allowed) return;
        this.hidden = false;
        this.buttons = [...this.querySelectorAll('[data-target]')];
        this.buttons.forEach((b) => b.addEventListener('click', () => this.toggle(b.dataset.target)));
      }

      toggle(name) {
        this.buttons.forEach((b) => {
          const open = b.dataset.target === name && b.getAttribute('aria-selected') !== 'true';
          b.setAttribute('aria-selected', String(open));
          const panel = this.querySelector(`[data-panel="${b.dataset.target}"]`);
          panel.hidden = !open;
          if (open) this.load(panel);
        });
      }

      // Inject the form markup/scripts on first open so Hulk initialises inside a visible container.
      load(panel) {
        if (panel.dataset.loaded) return;
        panel.dataset.loaded = 'true';
        const tpl = panel.querySelector('template');
        const frag = tpl.content.cloneNode(true);
        frag.querySelectorAll('script').forEach((old) => {
          const s = document.createElement('script');
          [...old.attributes].forEach((a) => s.setAttribute(a.name, a.value));
          s.textContent = old.textContent;
          old.replaceWith(s);
        });
        panel.appendChild(frag);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Partnership forms",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "gate_dev",
      "label": "Only show when the URL contains ?dev=1",
      "info": "Untick to publish for all visitors.",
      "default": true
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Partner with us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Looking to stock Anxious Preoccupied, or work with us as a creator? Choose an option below.</p>" },
    { "type": "header", "content": "Wholesale form" },
    { "type": "text", "id": "wholesale_button", "label": "Button label", "default": "Wholesale enquiries" },
    { "type": "text", "id": "wholesale_intro", "label": "Intro copy", "default": "Interested in stocking Anxious Preoccupied? Tell us a little about your business and we’ll be in touch." },
    { "type": "liquid", "id": "wholesale_embed", "label": "Hulk form embed code", "info": "Paste the Hulk Form Builder embed code / shortcode for the wholesale form." },
    { "type": "header", "content": "Creator and influencer form" },
    { "type": "text", "id": "creator_button", "label": "Button label", "default": "Creator & influencer partnerships" },
    { "type": "text", "id": "creator_intro", "label": "Intro copy", "default": "Interested in working with Anxious Preoccupied? Share your details and social channels below." },
    { "type": "liquid", "id": "creator_embed", "label": "Hulk form embed code", "info": "Paste the Hulk Form Builder embed code / shortcode for the creator form." },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "enable_color_scheme_transition", "label": "Use color scheme transition", "default": false },
    { "type": "color_scheme", "id": "color_scheme_transition", "label": "Transition color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Padding" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "default", "options": [{ "value": "none", "label": "None" }, { "value": "default", "label": "Default" }] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "default", "options": [{ "value": "none", "label": "None" }, { "value": "default", "label": "Default" }] }
  ],
  "presets": [{ "name": "Partnership forms" }]
}
{% endschema %}
