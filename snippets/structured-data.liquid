{% comment %} compare product filter with json-ld and prestige, check any other types shopify article {% endcomment %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    {%- assign same_as_links = settings.social_twitter_link | append: '|' | append: settings.social_facebook_link | append: '|' | append: settings.social_pinterest_link | append: '|' | append: settings.social_instagram_link | append: '|' | append: settings.social_tiktok_link | append: '|' | append: settings.social_tumblr_link | append: '|' | append: settings.social_snapchat_link | append: '|' | append: settings.social_youtube_link | append: '|' | append: settings.social_vimeo_link | split: '|' -%}
    "sameAs": [
      {%- assign same_as_first = true -%}
      {%- for link in same_as_links -%}
        {%- if link != blank -%}
          {%- unless same_as_first %},{% endunless -%}
          {{ link | json }}
          {%- assign same_as_first = false -%}
        {%- endif -%}
      {%- endfor -%}
    ],
    "founder": { "@type": "Person", "name": "Joanne McNally" },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "hi@anxiouspreoccupied.com",
      "url": {{ request.origin | append: '/pages/contact' | json }}
    },
    "url": {{ request.origin | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- comment -%}
    AEO: Shopify's own Product schema is kept as the base (variants, prices, SKUs). We add to each offer:
    - availability PreOrder for products tagged 'preorder' (Shopify always says InStock),
    - the 30-day return policy from the live refund policy,
    - Ireland delivery cost (EUR 8, free from EUR 170) when the price is shown in euros. Other countries are
      priced by weight in 30 zones, so they are not stated.
  {%- endcomment -%}
  {%- assign product_sd = product | structured_data -%}
  {%- if product.tags contains 'preorder' -%}
    {%- assign product_sd = product_sd | replace: 'InStock', 'PreOrder' -%}
  {%- endif -%}
  {%- capture offer_extras -%}
    "hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":[{%- for c in localization.available_countries -%}{{ c.iso_code | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow","merchantReturnDays":30,"returnMethod":"https://schema.org/ReturnByMail","returnFees":"https://schema.org/ReturnShippingFees"{%- if shop.refund_policy != blank -%},"merchantReturnLink":{{ request.origin | append: shop.refund_policy.url | json }}{%- endif -%}},
    {%- if cart.currency.iso_code == 'EUR' -%}
      {%- assign ie_rate = nil -%}
      {%- if product.price_min >= 17000 -%}
        {%- assign ie_rate = '0.00' -%}
      {%- elsif product.price_max < 17000 -%}
        {%- assign ie_rate = '8.00' -%}
      {%- endif -%}
      {%- if ie_rate != nil -%}
        "shippingDetails":{"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":"{{ ie_rate }}","currency":"EUR"},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"IE"},"deliveryTime":{"@type":"ShippingDeliveryTime","transitTime":{"@type":"QuantitativeValue","minValue":1,"maxValue":3,"unitCode":"DAY"}}},
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}
  {%- assign offer_extras = offer_extras | strip_newlines | strip -%}
  {%- assign offer_extras_priced = offer_extras | append: '"priceCurrency"' -%}
  {%- assign product_sd = product_sd | replace: '"priceCurrency"', offer_extras_priced -%}
  {%- comment -%}
    AEO: the Size Guide text (product metafield custom.size_guide) is shown on every product page. Add it to the
    schema as a named property so search and AI can read the dimensions without parsing the page.
  {%- endcomment -%}
  {%- assign size_guide_text = product.metafields.custom.size_guide | metafield_tag | replace: '<', ' <' | strip_html | strip_newlines | split: ' ' | join: ' ' -%}
  {%- if size_guide_text != blank -%}
    {%- capture dimensions_json -%}"additionalProperty":[{"@type":"PropertyValue","name":"Dimensions","value":{{ size_guide_text | json }}}],"brand":{%- endcapture -%}
    {%- assign product_sd = product_sd | replace_first: '"brand":', dimensions_json -%}
  {%- endif -%}
  <script type="application/ld+json">
    {{ product_sd }}
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection.handle != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ request.origin | append: collection.url | json }},
      {%- if collection.description != blank %}
      "description": {{ collection.description | strip_html | strip_newlines | truncate: 300 | json }},
      {%- endif %}
      "isPartOf": { "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ request.origin | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for p in collection.products limit: 24 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ request.origin | append: p.url | json }},
              "name": {{ p.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}    
  </script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumbs_homepage' | t | json }},
      "item": "{{ request.origin }}"
    }
    {%- case request.page_type -%}
      {%- when 'collection' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
      {%- when 'product' -%}
        {%- if collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- endif -%}
      {%- when 'page' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": {{ request.origin | append: page.url | json }}
        }
      {%- when 'blog' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ request.origin | append: blog.url | json }}
        }
      {%- when 'article' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ request.origin | append: blog.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": {{ request.origin | append: article.url | json }}
        }
    {%- endcase %}
  ]
}
</script>