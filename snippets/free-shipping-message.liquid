{% comment %}
  Market-aware free-shipping message (audit issue #16).

  - Only renders for Ireland (IE) and the United Kingdom (GB), each with its
    own threshold/text.
  - For every other country/market it outputs an EMPTY <free-shipping-bar>
    element. The CSS rule below hides the whole column slide when empty, so the
    hardcoded euro figure never shows to shoppers browsing in another currency
    (e.g. PHP) and no broken empty slide is left behind.

  Detection uses the shopper's active country (localization.country.iso_code),
  which follows the Shopify Market they are browsing in.

  EDIT THE TWO MESSAGES BELOW to match your live shipping policy.
{% endcomment %}

{%- liquid
  assign country = localization.country.iso_code

  assign ie_message = 'Free Shipping Over €150'
  assign uk_message = 'Free Shipping Over £135'

  assign message = ''
  if country == 'IE'
    assign message = ie_message
  elsif country == 'GB'
    assign message = uk_message
  endif
-%}

{%- style -%}
  free-shipping-bar { display: contents; }
  .slider-component__item:has(> .rte > free-shipping-bar:empty),
  .multicolumn__item:has(free-shipping-bar:empty) { display: none; }
{%- endstyle -%}
<free-shipping-bar>{%- if message != blank -%}{%- render 'icon', icon: 'box', class: 'icon--m' -%}<h3 class="rich-text__heading heading h6 free-shipping-message">{{ message }}</h3>{%- endif -%}</free-shipping-bar>
