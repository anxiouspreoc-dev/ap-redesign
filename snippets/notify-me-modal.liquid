<notify-me-modal data-modal="true" data-overlay="false" data-name="notify-me" data-display="flex">
  <dialog class="dialog dialog--notification" aria-labelledby="notify-me-heading">
    <div class="dialog__window dialog__animateable dialog__window--custom-alignment" data-color-scheme="{{ settings.overlay_color_scheme }}">
      <header class="dialog__header dialog__header--border">
        <h2 id="notify-me-heading" class="h5">Notify Me When Available</h2>
        {% render 'close-button' %}
      </header>
      <div class="rte notify-me-modal__body">
        <div data-notify-state="form">
          <p data-notify-product-line></p>
          <form data-notify-form novalidate>
            <div class="field">
              <label class="field__label" for="notify-me-email">Email</label>
              <input
                type="email"
                id="notify-me-email"
                name="email"
                placeholder=" "
                class="field__input"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                required
              >
            </div>
            <div class="notify-me-modal__error" data-notify-error hidden></div>
            <button type="submit" class="button button--primary button--full" data-notify-submit>
              Notify Me
            </button>
          </form>
        </div>
        <div data-notify-state="success" hidden>
          <p>Thanks! We'll email you as soon as this is back in stock.</p>
          <button type="button" data-close class="button button--primary button--full">
            {{ 'accessibility.close' | t }}
          </button>
        </div>
      </div>
    </div>
  </dialog>
</notify-me-modal>

{% style %}
  .notify-me-modal__body form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }
  .notify-me-modal__body input[type="email"] {
    width: 100%;
  }
  .notify-me-modal__error {
    color: rgb(var(--color-error));
    font-size: 0.875rem;
  }
{% endstyle %}
