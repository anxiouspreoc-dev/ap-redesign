{% doc %}
  @prompt
    Create a full-width feature section with a small all-caps label at the top that reads "What makes it work", followed by a large heading that reads "Every single thing you need. Zero nappy bag energy."
    Below the heading, display a 2x2 grid of feature cards. Each card has: an image upload field at the top (for an icon or small graphic), a short bold title, and 2 sentences of body copy. 
    
    Below the grid, display a horizontal row of pill-shaped chips that read: "Works for the office too", "Running errands", "Gym bag", "Travel carry-on", "Back to brunch".
    Add editable settings in the sidebar for: section background colour, section padding top and bottom, each card's background colour, card border colour, card border radius, image size per card, chip background colour, chip text colour, all heading and body text colours.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
  }

  .ai-feature-section__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-feature-section__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-feature-section__label-{{ ai_gen_id }} {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-feature-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-feature-section__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 48px;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    text-align: center;
  }

  .ai-feature-card__image-wrapper-{{ ai_gen_id }} {
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-feature-card__image-{{ ai_gen_id }} {
    width: {{ block.settings.card_image_size }}px;
    height: {{ block.settings.card_image_size }}px;
    object-fit: contain;
  }

  .ai-feature-card__image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.card_image_size }}px;
    height: {{ block.settings.card_image_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 8px;
  }

  .ai-feature-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px 0;
  }

  .ai-feature-card__body-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_body_size }}px;
    color: {{ block.settings.card_body_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-feature-section__chips-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .ai-feature-chip-{{ ai_gen_id }} {
    background-color: {{ block.settings.chip_background_color }};
    color: {{ block.settings.chip_text_color }};
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-section__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-feature-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-feature-card-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-feature-section__chips-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-feature-chip-{{ ai_gen_id }} {
      font-size: 12px;
      padding: 8px 16px;
    }
  }
{% endstyle %}

<div class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-section__container-{{ ai_gen_id }}">
    <div class="ai-feature-section__header-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-feature-section__label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-feature-section__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="ai-feature-section__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_body_key = 'card_' | append: i | append: '_body'
          
          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_body = block.settings[card_body_key]
        %}
        
        <div class="ai-feature-card-{{ ai_gen_id }}">
          <div class="ai-feature-card__image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 400 }}"
                alt="{{ card_image.alt | escape }}"
                class="ai-feature-card__image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.card_image_size }}"
                height="{{ block.settings.card_image_size }}"
              >
            {% else %}
              <div class="ai-feature-card__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          {% if card_title != blank %}
            <h3 class="ai-feature-card__title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
          
          {% if card_body != blank %}
            <div class="ai-feature-card__body-{{ ai_gen_id }}">{{ card_body }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-feature-section__chips-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign chip_text_key = 'chip_' | append: i | append: '_text'
          assign chip_text = block.settings[chip_text_key]
        %}
        
        {% if chip_text != blank %}
          <div class="ai-feature-chip-{{ ai_gen_id }}">{{ chip_text }}</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

