{
  "sections": {
    "image-banner": {
      "type": "image-banner",
      "blocks": {
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Joanne McNally &amp; Nikki Lannen, Founders</p>",
            "font_style": "body text-s"
          }
        }
      },
      "block_order": ["text"],
      "settings": {
        "height": "medium",
        "mobile_height": "large",
        "stack": "none",
        "spacing": "0px",
        "media_content_padding": "default",
        "container_type": "full",
        "container_width": "xxs",
        "horizontal_alignment": "left",
        "vertical_alignment": "bottom",
        "enable_banner_click": false,
        "enable_overlay": false,
        "overlay": "linear-gradient(180deg, rgba(0, 0, 0, 0.5), rgba(255, 255, 255, 0) 100%)",
        "color_scheme": "scheme-4",
        "enable_color_scheme_transition": false,
        "color_scheme_transition": "",
        "padding_top": "0px",
        "padding_bottom": "0px",
        "show_top_border": false,
        "show_bottom_border": false
      }
    },
    "rich-text-columns": {
      "type": "rich-text-columns",
      "blocks": {
        "rich-text-column": {
          "type": "_rich-text-column",
          "settings": { "horizontal_alignment": "left" },
          "blocks": {
            "heading-group": {
              "type": "heading-group",
              "settings": { "page_title": true },
              "blocks": {
                "subheading": {
                  "type": "_subheading",
                  "settings": { "subheading": "About Anxious Preoccupied" }
                },
                "heading": {
                  "type": "_heading",
                  "settings": {
                    "heading": "Emotional baggage, but make it chic.",
                    "heading_size": "h2"
                  }
                }
              },
              "block_order": ["subheading", "heading"]
            },
            "text": { "type": "text", "settings": { "text": "", "font_style": "body" } }
          },
          "block_order": ["heading-group", "text"]
        },
        "rich-text-column-2": {
          "type": "_rich-text-column",
          "settings": { "horizontal_alignment": "left" },
          "blocks": {
            "text-2": {
              "type": "text",
              "settings": {
                "text": "<p>Anxious Preoccupied was founded by Joanne McNally and Nikki Lannen &mdash; best friends for over 15 years &mdash; for women with zero interest in choosing between style and function. For those with ten tabs open, a missed voice note and calendar chaos, our accessories are designed to keep up.</p><p>Proudly Irish designed, every piece is crafted from premium vegan leather and built for real life: commuting, travelling, overpacking emotionally and physically, and carrying far more than you originally intended.</p><p><strong>Life is chaotic, so your accessories shouldn&rsquo;t be.</strong></p>",
                "font_style": "body"
              }
            }
          },
          "block_order": ["text-2"]
        }
      },
      "block_order": ["rich-text-column", "rich-text-column-2"],
      "settings": {
        "vertical_alignment": "top",
        "color_scheme": "",
        "enable_color_scheme_transition": false,
        "color_scheme_transition": "",
        "padding_top": "default",
        "padding_bottom": "default",
        "show_top_border": true,
        "show_bottom_border": false
      }
    },
    "media-grid": {
      "type": "media-grid",
      "blocks": {
        "media-grid-image": { "type": "_media-grid-image", "settings": { "image_ratio": "2 / 3", "link": "", "link_label": "" } },
        "media-grid-image-2": { "type": "_media-grid-image", "settings": { "image_ratio": "2 / 3", "link": "", "link_label": "" } },
        "media-grid-image-3": { "type": "_media-grid-image", "settings": { "image_ratio": "2 / 3", "link": "", "link_label": "" } },
        "media-grid-image-4": { "type": "_media-grid-image", "settings": { "image_ratio": "2 / 3", "link": "", "link_label": "" } },
        "media-grid-image-5": { "type": "_media-grid-image", "settings": { "image_ratio": "2 / 3", "link": "", "link_label": "" } },
        "section-header": {
          "type": "_section-header",
          "static": true,
          "settings": {
            "layout_header": "left",
            "subheading": "",
            "heading": "",
            "page_title": false,
            "heading_size": "h2",
            "text": "",
            "button_label": "",
            "button_link": ""
          }
        },
        "button-group": {
          "type": "button-group",
          "static": true,
          "settings": { "horizontal_alignment": "inherit" }
        }
      },
      "block_order": ["media-grid-image", "media-grid-image-2", "media-grid-image-3", "media-grid-image-4", "media-grid-image-5"],
      "settings": {
        "columns_desktop": "4",
        "columns_mobile": "2",
        "column_behavior": "slideshow",
        "container_type": "max",
        "grid_gap_vertical": "default",
        "grid_gap_horizontal": "default",
        "arrow_position": "overlay",
        "counter_style": "hidden",
        "button_style": "primary",
        "color_scheme": "",
        "enable_color_scheme_transition": false,
        "color_scheme_transition": "",
        "padding_top": "0px",
        "padding_bottom": "default",
        "show_top_border": false,
        "show_bottom_border": false
      }
    },
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "heading-group": {
          "type": "heading-group",
          "settings": { "page_title": false },
          "blocks": {
            "heading": {
              "type": "_heading",
              "settings": { "heading": "Regulate your inbox.", "heading_size": "h2" }
            }
          },
          "block_order": ["heading"]
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Sign up for the Anxious Preoccupied newsletter and be first to know about new drops, restocks and exclusive access.</p>",
            "font_style": "body"
          }
        },
        "newsletter": {
          "type": "_newsletter",
          "settings": { "button_style": "secondary", "button_width": "default" }
        }
      },
      "block_order": ["heading-group", "text", "newsletter"],
      "settings": {
        "height": "medium",
        "mobile_height": "large",
        "stack": "none",
        "spacing": "0px",
        "media_content_padding": "default",
        "container_type": "full",
        "container_width": "xs",
        "horizontal_alignment": "center",
        "vertical_alignment": "middle",
        "enable_overlay": false,
        "overlay": "linear-gradient(180deg, rgba(0, 0, 0, 0.5), rgba(255, 255, 255, 0) 100%)",
        "color_scheme": "scheme-2",
        "enable_color_scheme_transition": false,
        "color_scheme_transition": "",
        "show_top_border": false,
        "show_bottom_border": false
      }
    }
  },
  "order": ["image-banner", "rich-text-columns", "media-grid", "newsletter"]
}
